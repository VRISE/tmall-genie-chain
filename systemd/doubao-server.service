[Unit]
Description=豆包 chat/TTS 上游（本机 127.0.0.1:9090）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/fly
Environment=DOUBAO_REPO=/root/fly
# systemd 的 PATH 里没有 /opt 那份 node，解链兜底要用绝对路径
Environment=DY_NODE=/opt/node-v22.20.0-linux-armv7l/bin/node
Environment=DY_HELPER=/root/fly/dy_resolve.mjs
ExecStart=/usr/bin/python3 /root/fly/doubao_server.py --host 127.0.0.1 --port 9090
Restart=always
RestartSec=5
StandardOutput=append:/var/log/doubao-server.log
StandardError=append:/var/log/doubao-server.log

[Install]
WantedBy=multi-user.target
