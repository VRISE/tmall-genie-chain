# 复制成 migpt.env 再填值：cp migpt.env.example migpt.env && chmod 600 migpt.env
# 这份文件永远不要提交（.gitignore 已挡）。config.js 只认 process.env，
# 所以启动脚本必须先把它 export 进环境（见 run.sh）。

# ── 小米音箱 ────────────────────────────────
MI_SPEAKER_NAME=            # 米家/App 里显示的设备名，一字不差（「音响」和「音箱」是两个不同的名字）
MI_USER_ID=                 # 小米 ID（一串数字，在小米账号「个人信息」里，不是手机号）
MI_PASSWORD=                # 密码登录常被小米风控拦；能用 MI_PASS_TOKEN 就别用密码
MI_PASS_TOKEN=              # https://github.com/idootop/migpt-next/issues/4

# ── 大模型（OpenAI 兼容即可）────────────────
LLM_BASE_URL=http://127.0.0.1:7790/v1   # 本仓库自带的豆包桥；换成云端就填 https://…/v1
LLM_API_KEY=                # 局域网自建的桥也要填，值就是桥的 bridge.key
LLM_MODEL=doubao
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.7

# ── 豆包的声音（只有后端是豆包反代时才有用）──
DOUBAO_VOICE=1
# 音箱是「自己去抓这条 URL」的，所以必须填音箱抓得到的局域网 IP；
# 写 localhost / 127.0.0.1 的结果是：小爱一句话也不说，日志里看不出原因。
VOICE_BASE_URL=http://192.168.5.42:7790

# ── 行为 ────────────────────────────────────
HISTORY_MAX=6
HEARTBEAT_MS=3000
DEBUG=1
# 白名单：这些开头的说法交给音箱原生，不接管（逗号分隔，按开头匹配）
NATIVE_WORDS=
ALARM_WORDS=
# 不接管时是否静音、静音守卫毫秒
MUTE_COIN=0
MUTE_GUARD_MS=3000
# ⚠ 刻意留空：不要往大模型账号里塞 persona/额外指令，见 docs/05-踩坑清单.md 第 21 条
SYSTEM_PROMPT=

# ── 出屏那条腿（本机播放器，可选）───────────
PLAYER_ON=1
PLAYER_PY=/root/fly/gst_play.py
PLAYER_PYTHON=/usr/bin/python3
PLAYER_MAX_H=540            # RK322x 只能吃 540 档，1080 硬解追不上
PLAYER_GRAB=karaoke.service # 它占着 HDMI 的 DRM master，不停它就 Cannot set CRTC
PLAYER_ADEV=
PLAY_HISTORY=/root/fly/play-history.jsonl
FLY_BRAIN_URL=              # 留空 = 不接额外的大脑仿真，纯问答
FLY_BRAIN_TIMEOUT_MS=9000
FLY_IN_REPLY=0
GF_REFUSE_HZ=
